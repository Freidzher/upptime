FINE_GRAINED_TOKEN=
# Формат: [ID|]цель[|иконка] — разделитель | (без пробелов).
# ID — число: целое ('1') = группа/ВМ (заголовок на странице), дробное ('1.1') = вложенный сервис.

# --- Группа 1 (ВМ) и её сервисы ---
SERVER1=1|https://example.com
SERVER2=1.1|https://app.example.com
SERVER3=1.2|203.0.113.10
# --- Группа 2 ---
SERVER4=2|https://example.org|https://example.org/favicon.ico
# --- Без ID (в конце списка) ---
SERVER5=https://legacy.example.net