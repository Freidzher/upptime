# Runicore Monitor — переменные окружения.
# Скопируйте в .env и заполните. Реальный .env не коммитится (в .gitignore).
#
# Каждый секрет (кроме FINE_GRAINED_TOKEN) = один мониторимый сайт.
# Имя сайта формируется из имени секрета: RU_SERVER_1 -> RU Server 1
#
# FINE_GRAINED_TOKEN — GitHub Personal Access Token для sync_secrets.py
#   (Settings → Developer settings → Fine-grained tokens →
#    Repository access: только этот репо; Permissions: Contents RW, Issues RW, Administration RW — для записи секретов)
FINE_GRAINED_TOKEN=

# --- Ваши сайты ---
SERVER1=https://example.com
SERVER2=https://example.org